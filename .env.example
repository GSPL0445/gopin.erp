# ---------------------------------------------------------------
# Gopin Semicon ERP — settings. Copy this file to ".env" and edit.
# Never share your .env file or put it on GitHub.
# ---------------------------------------------------------------

# Port the app listens on
PORT=3000

# Long random secret for login sessions (at least 32 characters).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_to_a_long_random_string_of_at_least_32_chars

# How long a login lasts, in hours
SESSION_HOURS=12

# Set to true once the site runs on https:// (behind Nginx + SSL)
COOKIE_SECURE=false
# Set to true when Nginx (or another proxy) sits in front of the app
TRUST_PROXY=false

# ---- Database (used by docker-compose) ----
POSTGRES_DB=gopin_erp
POSTGRES_USER=gopin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- Database (only when running WITHOUT Docker) ----
# DATABASE_URL=postgres://gopin:CHANGE_ME_strong_db_password@localhost:5432/gopin_erp
# DATABASE_SSL=false

# ---- First Admin login (created on first start if there are no users) ----
ADMIN_EMAIL=admin@gopinsemicon.com
ADMIN_NAME="ERP Admin"
ADMIN_PASSWORD=CHANGE_ME_first_admin_password

COMPANY_NAME="Gopin Semicon Private Limited"
